# ============================================================================
# CncTion 1338NP-12 固件工程 —— 唯一的"版本号文件"
# ----------------------------------------------------------------------------
# 升级到后续系统时，通常只需要改 OPENWRT_VERSION / FIRMWARE_BUILD 两项，
# 然后重跑 build.sh（本地或 GitHub Actions）即可。
# 其余各项都是"钉死"的：改动前请先读该行注释。
# ============================================================================

# --- 目标平台（本机 CncTion 1338NP-12：x86_64 / UEFI / 4×Intel I226-V）-------
OPENWRT_VERSION=25.12.5
OPENWRT_TARGET=x86
OPENWRT_SUBTARGET=64
OPENWRT_ARCH=x86_64
OPENWRT_KVER=6.12.94
OPENWRT_KVERMAGIC=a7bc15f451f9652701ba04af9cfb0b95

# --- 下载源（大陆构建机建议换镜像；路径结构与官方一致）---------------------
# 官方      : https://downloads.openwrt.org
# 清华 TUNA : https://mirrors.tuna.tsinghua.edu.cn/openwrt
# 中科大    : https://mirrors.ustc.edu.cn/openwrt
# 南大      : https://mirror.nju.edu.cn/openwrt
OPENWRT_MIRROR=https://downloads.openwrt.org
# 可选：给 github.com 拉取加前缀（如 https://ghfast.top/ ），留空表示直连
GITHUB_PROXY=

# --- 工具链校验和（取自官方 sha256sums，防止中途被换包）---------------------
SDK_FILE=openwrt-sdk-${OPENWRT_VERSION}-x86-64_gcc-14.3.0_musl.Linux-x86_64.tar.zst
SDK_SHA256=0c8df0151a1e88feb7c03d694d61f6a18d51872815b7c811d76e2b77504d5e9c
IMAGEBUILDER_FILE=openwrt-imagebuilder-${OPENWRT_VERSION}-x86-64.Linux-x86_64.tar.zst
IMAGEBUILDER_SHA256=313221253d9bac534e4a4ee6492a4941b4ba0f43200eceb8d16a4785470ae9df

# --- 分区布局常量（★绝对不要改★）-------------------------------------------
# 默认 sysupgrade 会比较"镜像 GPT"与"磁盘 GPT"：一致才按分区逐个写入（不动
# 镜像里没有的分区、保住数据分区），不一致就整盘覆写。改这两个值 = 换布局 =
# 以后升级变成整盘写。p1=64MiB 是有意为之：platform_copy_config 把配置备份
# 写到 p1，官方默认 16MiB 放不下 OpenClash 的配置。
KERNEL_PARTSIZE=64
ROOTFS_PARTSIZE=4096

# --- 固件标识（每次发新固件改 FIRMWARE_BUILD）------------------------------
# r4 = 2026-10-08：把 Lucky 从"SDK 编 2.27.2"换成作者发布的三个预编译 apk
#      （核心 3.1.3-beta + LuCI 3.0.0 + 中文包，见本文件开头 Lucky 那段）。
#      之所以必须升号：这不是"顺手升个插件"，而是**拆掉一个刷机即故障的地雷** ——
#      设备自己早就自更新到 3.x，镜像里带 2.27.2 会在刷机时把 Lucky 降级，
#      而 3.x 写的加密配置 2.27.2 解不开（§7.8 的 panic 实录）。刷入 r4 之后，
#      镜像里的核心首次"≥ 设备上的核心"。同时退役的有：LUCKY_TARBALL_SHA256、
#      build.sh 里给上游 Makefile 植入校验的那套补丁（patch_lucky_makefile /
#      check_lucky_verified），以及 gdy666/luci-app-lucky 这份源码的 clone。
#      ★ 刷 r4 之前仍建议按 §7.8.4 导出一次 Lucky 配置备份（多留一份在电脑上）。
# r3 = 2026-10-03 晚：把 log_size=512 从"改 files/etc/config/system"改成
#      "首启脚本里的幂等迁移"。原因：/etc/config/system 在升级时会被设备上的旧配置
#      覆盖（真机 sysupgrade -l 里就有它），于是 r2 的效果是"镜像里 512、升级后真机
#      仍 128"。r2 保持不动，继续当回滚靶子；r3 才会让已升级的设备真正吃到 512。
#      详见手册 §8.3 与 verify.sh 的 cnc-migrate 哨兵。
# r2 = 2026-10-03 这次：修掉升级链路上的静默失效点、加发布门禁、OpenClash 回到
#      Release 版（0.47.156）。之所以要升号而不是原地重发 r1：
#        * "按版本 Release（便于回滚）"是靠 tag 区分的，原地重发会把 r1 那份
#          （含 kmod-nft-tproxy 与 IPTV 修复）覆盖掉，就少了回滚靶子；
#        * 也顺便让路由器端一眼看出"这次是新固件"。
#      （即便忘了升号，cnc-upgrade 现在也会靠 built_at 识别出"同名重发"。）
FIRMWARE_NAME=cnc1338np12
FIRMWARE_BUILD=r4

# --- 发布地址（CI 里会自动取 $GITHUB_REPOSITORY 覆盖；本地构建填自己的仓库）--
# 产物与 latest.json 都挂在固定 tag 的"滚动 Release"上，URL 永久不变。
RELEASE_REPO=fqscfqj/cnc-openwrt-firmware
RELEASE_TAG=firmware-latest

# --- 第三方源码（分支 + 固定 commit；升级大版本时改 BRANCH，并更新 COMMIT）----
IMMORTALWRT_PACKAGES_REPO=https://github.com/immortalwrt/packages
IMMORTALWRT_PACKAGES_BRANCH=openwrt-25.12
IMMORTALWRT_PACKAGES_COMMIT=84bd86384928955b568988ca0e09e2c78c75173d

IMMORTALWRT_LUCI_REPO=https://github.com/immortalwrt/luci
IMMORTALWRT_LUCI_BRANCH=openwrt-25.12
IMMORTALWRT_LUCI_COMMIT=d6167ea0645cbd1327708d85f94824f42d0eb872

# --- Lucky：不再用 SDK 编，改为钉作者发布的三个预编译 apk（见下方 PREBUILT_APKS）---
# 背景（2026-10-08 改动，对应 FIRMWARE_BUILD=r4）：
#   * 旧做法：SDK 编 gdy666/luci-app-lucky 的 lucky 包（PKG_VERSION=2.27.2，它自己
#     wget 一个预编译 tar.gz 当载荷）+ luci-app-lucky 前端。因为那份载荷"上游不看
#     PKG_HASH"，build.sh 还得**就地给上游 Makefile 的 Build/Prepare 打补丁**才能校验
#     sha256（patch_lucky_makefile / check_lucky_verified，现随本次改动整体删除）。
#   * 为什么必须升：Lucky 自带的"版本更新"会把自己换成官方 3.x，而 **3.x 写的 .lkcf
#     配置是加密容器，2.27.2 解不开** —— 镜像里钉 2.27.2 ⇒ 每次刷机都把设备上的 Lucky
#     降级 → panic、procd 崩 5 次后彻底不跑（手册 §7.8 有 2026-10-03 的真机实录）。
#   * 现在作者把 3.x **按 OpenWrt 25.12 的 APKv3 逐架构发布**了（不再是"内测版没有稳定
#     下载地址"）：release.66666.host 的 `<版本>beta/apk/` 下有核心、LuCI 前端、中文包
#     三个 apk，附 SHA256SUMS + MANIFEST.json（含 core_sha256 / source_archive_sha256）。
#     ★ 已核对：从该站点下的 lucky_2.27.2_Linux_x86_64.tar.gz，sha256 与本工程原来钉的
#       LUCKY_TARBALL_SHA256 **完全一致** ⇒ 它就是作者本人的分发站，不是第三方重打包。
#     ★ 包内路径 /home/gdy/lucky-template-7bce07d/... ⇒ 这三个 apk 是用**上游自己的打包
#       模板**（gdy666/luci-app-lucky 提交 7bce07d）构建的：文件清单为
#       /etc/config/lucky(conffile)、/etc/init.d/lucky、/usr/bin/lucky、
#       /usr/libexec/lucky-call、/usr/share/lucky/arch，只依赖 libc。
#   * ★ 配置目录没变 ★：新 init 脚本的 DEFAULT_CONFIG_DIR 与 /etc/config/lucky 里的
#     configdir 仍是 /etc/config/lucky.daji ⇒ keep.d / sysupgrade.conf 一行都不用改，
#     设备上的配置与订阅原样继续用。
#   * 换版本时：改下面 PREBUILT_APKS 里那三行（URL + sha256），并把 LUCKY_VERSION 一起改。
LUCKY_VERSION=3.1.3
# 只是给人读的"这三行 apk 来自哪个发布目录"，脚本不解析它
LUCKY_APK_RELEASE=v3.1.3beta

# --- 预编译 apk（格式：目录|发布文件名|下载地址|sha256|放进 ImageBuilder 的规范文件名）---
# 全部为 apk v3（文件头 ADBd），与 OpenWrt 25.12 的 apk-tools 兼容；
# ImageBuilder 用 apk mkndx --allow-untrusted 建本地索引，无需签名。
# 共 10 个：openclash 1 + argon 3 + bandix 3 + lucky 3（详见上面 Lucky 那段）。
#
# ★ 第 5 个字段（规范文件名）不能省：apk 安装时按 `<name>-<version>.apk` 去找文件，
#   而第三方 Release 的命名常常是 `<name>-<version>_<arch>.apk`，或把版本里的 `~`
#   写成 `.`（例如 `...-26.249.51071.0bd9b61_all.apk` 的内部版本其实是
#   `26.249.51071~0bd9b61`）。文件名对不上就会报：
#       ERROR: <pkg>: package mentioned in index not found (try 'apk update')
#   下面这 4 项就是按这个规则改过名的（其余各项本身已经规范，直接同名）。
#   ★ lucky 那三项的文件名也是规范的（`<name>-<version>.apk`，版本号里的点就是包内的
#     版本号，例如 luci-i18n-lucky-zh-cn 的包内版本确实是 0.261003.02487），所以第 5
#     个字段与第 2 个字段相同。
#
# 说明：
#   openclash = LuCI 前端（arch all），Clash 内核首启后在插件页下载
#   argon     = 主题 + 主题配置页 + 中文语言包
#   bandix    = 流量监控核心（x86_64，Rust）+ LuCI 前端 + 中文语言包
#   lucky     = 核心（x86_64，Go，静态链接，只依赖 libc）+ LuCI 前端（noarch，
#               依赖 lucky + rpcd-mod-file，后者由官方仓库解析）+ 中文语言包
#
# ★ openclash 钉 GitHub Release 版（0.47.156），不跟 `package` 分支上的 0.47.168 ★
#   OpenClash 把预编译包放在两个地方：
#     * GitHub Release（如 v0.47.156）——「稳定/master」通道，**tag 与资产都不会变**；
#     * `package` 分支的 dev/ 与 master/ 目录 —— 插件自己「检查更新」时拉的地方，
#       内容会被上游反复覆盖（0.47.168 只存在于这里，没有对应的 Release）。
#   本工程选 Release：URL 与字节都长期稳定、构建可复现；dev 分支那份只能靠 sha256 兜底，
#   上游一覆盖就得跟着改 hash —— 属于"会自己过期"的钉法。
#   ⚠️ 代价要知情：真机上现在装的是 0.47.168（`openclash.config.release_branch='dev'`），
#   所以刷入本镜像后 **LuCI 前端会回到 0.47.156**；/etc/openclash（配置、订阅、内核、
#   规则集）由 keep.d 保留，配置项在 uci 里也会保留，因此这个"降级"是可用状态。
#   若以后更想跟着 dev 走：要么设备上保持 release_branch='dev' 让插件自己更新（那就
#   别往镜像里钉 dev 版），要么回到"钉 dev 分支 + sha256"并接受上游覆盖后要改这里。
#   sha256 来源：GitHub Release 资产的 digest 字段（已与本机实际下载的字节比对一致）。
PREBUILT_APKS="
openclash|luci-app-openclash-0.47.156.apk|https://github.com/vernesong/OpenClash/releases/download/v0.47.156/luci-app-openclash-0.47.156.apk|1e4f330fc654e0270ac9cfa762af221335567d9b89388219890e8a7745b914ab|luci-app-openclash-0.47.156.apk
argon|luci-theme-argon-2.4.7-r1.apk|https://github.com/jerrykuku/luci-theme-argon/releases/download/v2.4.7/luci-theme-argon-2.4.7-r1.apk|c5f0e3a55ef96213884184be9aeaadc8586418986c4dde1ff1866be5e938aaef|luci-theme-argon-2.4.7-r1.apk
argon|luci-app-argon-config-2.4.7-r1.apk|https://github.com/jerrykuku/luci-theme-argon/releases/download/v2.4.7/luci-app-argon-config-2.4.7-r1.apk|506e2bc4bef7d40fab051bb38902f71a8af0356ebe765f01b1808f6d2ce8bf8f|luci-app-argon-config-2.4.7-r1.apk
argon|luci-i18n-argon-config-zh-cn-26.103.13761.3e099a3.apk|https://github.com/jerrykuku/luci-theme-argon/releases/download/v2.4.7/luci-i18n-argon-config-zh-cn-26.103.13761.3e099a3.apk|00163d6b9d7f1fccae84bd220c6f3c9a4f78fe063b1d12408127d36bfe38dd7e|luci-i18n-argon-config-zh-cn-26.103.13761~3e099a3.apk
bandix|bandix-0.12.10-r1_x86_64.apk|https://github.com/timsaya/openwrt-bandix/releases/download/v0.12.10/bandix-0.12.10-r1_x86_64.apk|2cd573a6d547f678ed8e5787d6bc1cc1655d874ad539e6a66a2e7c27cc62b1a8|bandix-0.12.10-r1.apk
bandix|luci-app-bandix-0.12.11-r1_all.apk|https://github.com/timsaya/luci-app-bandix/releases/download/v0.12.11/luci-app-bandix-0.12.11-r1_all.apk|b2415021d016404f7be7672352015f75017c4a3d3f847235d16ac25f0dbc74ee|luci-app-bandix-0.12.11-r1.apk
bandix|luci-i18n-bandix-zh-cn-26.249.51071.0bd9b61_all.apk|https://github.com/timsaya/luci-app-bandix/releases/download/v0.12.11/luci-i18n-bandix-zh-cn-26.249.51071.0bd9b61_all.apk|b1089b2d640734b1c68195d7abaf7170b548c08d525576b1549d4bb2ce07c9c2|luci-i18n-bandix-zh-cn-26.249.51071~0bd9b61.apk
lucky|x86_64/lucky-3.1.3-r1.apk|https://release.66666.host/v3.1.3beta/apk/lucky/x86_64/lucky-3.1.3-r1.apk|d860ff790455d1e26b51f4dd594d9d9a4eeea9c6aabad4f96dc3aca576700596|lucky-3.1.3-r1.apk
lucky|luci-app-lucky-3.0.0-r1.apk|https://release.66666.host/v3.1.3beta/apk/luci-app-lucky-3.0.0-r1.apk|6a90e29e574eeb8c47d72b8f9dd37f78a683005dd4b94a60808869b686510c35|luci-app-lucky-3.0.0-r1.apk
lucky|luci-i18n-lucky-zh-cn-0.261003.02487.apk|https://release.66666.host/v3.1.3beta/apk/luci-i18n-lucky-zh-cn-0.261003.02487.apk|b77386e8f6f62a9c3c33e0f9b8077b099ad21b40851970e7dd2e4974c57193ea|luci-i18n-lucky-zh-cn-0.261003.02487.apk
"
# ★ 为什么镜像里敢放 3.1.3-beta ★
#   设备自己早就跑在 3.x 上了（§7.8 实录是 3.1.0），镜像里放"更旧的核心"才是故障源：
#   sysupgrade 会用镜像里的 /usr/bin/lucky 覆盖设备上那个，而 3.x 写的 .lkcf 配置
#   2.27.2 解不开 → panic。放 3.1.3（≥ 设备版本）后刷机不再降级，这条地雷才算拆掉。
#   站点上目前只有 v2.27.2 一个稳定版 + 三个 beta 目录（v3.0.0beta8 / v3.1.0beta /
#   v3.1.3beta）；3.x 一直没进 GitHub Release（GitHub 上核心最新仍是 v2.27.2），
#   所以想"跟着设备走"就只能钉这里的 beta —— sha256 已钉，完整性有保证，
#   唯一的风险是 release.66666.host 的可用性（EdgeOne CDN 加速）。
#   降级回 2.27.2 的办法：把这三行换成 SDK 编（git 历史里有完整实现），但那会同时
#   把设备上的 3.x 打回 2.27.2，**刷机前必须先导出 Lucky 配置备份**，见 §7.8。

# --- 用 SDK 自己编译的 6 个包（4 个来自 immortalwrt 源，2 个是本工程维护的）----
# 格式：包名|在源码树中的相对路径
#   * 前 4 个：immortalwrt 的 packages / luci 两份源码，按 commit 钉死后编译。
#   * luci-app-cnc-upgrade：本工程自写的在线升级页。
#   * luci-app-ap-modem  ：第三方（iStoreOS/易有云）插件的**源码化封装** ——
#                          上游只发 .ipk，而 25.12 是 apk 体系，装不进去。
#                          为什么不学 lucky 走 PREBUILT_APKS：那条路要求"作者
#                          发布了 25.12 的 apk 并给出 sha256"，而这个 app 没有
#                          apk 构建；源码化之后它就是普通自编包，verify.sh 与
#                          apk 断言都能覆盖到。来龙去脉见该包 Makefile 头部。
# ★ lucky / luci-app-lucky 自 r4 起**不在这里**★：它们改用上面 PREBUILT_APKS 里
#   作者发布的三个 apk（原因见本文件开头 Lucky 那段），于是上游 gdy666/luci-app-lucky
#   这份源码也不用再 clone 了（build.sh 的 stage_sources 已相应删掉）。
SDK_PACKAGES="
msd_lite|immortalwrt/packages/net/msd_lite
luci-app-msd_lite|immortalwrt/luci/applications/luci-app-msd_lite
vlmcsd|immortalwrt/packages/net/vlmcsd
luci-app-vlmcsd|immortalwrt/luci/applications/luci-app-vlmcsd
luci-app-cnc-upgrade|local/luci-app-cnc-upgrade
luci-app-ap-modem|local/luci-app-ap-modem
"

# --- SDK 源码树里"顺带产出"的语言包（★漏了它们 = 页面还是英文★）--------------
# luci.mk 会为每个 app 的 po/<语言>/ 目录自动生成 luci-i18n-<app>-<语言> 子包，
# 它和 app 写在同一个 Makefile 里、由同一次 `make package/<app>/compile` 产出。
# 但 build.sh 用 `find ... -name "<app>-*.apk"` 只捞 app 本体，语言包编出来了却被丢掉，
# 于是就出现"应用装上了、菜单和页面全是英文"。
# 这里逐个点名，build.sh 会一并复制进 ImageBuilder，并在缺失时直接构建失败。
# 格式：被编译的包名|顺带产出的语言包名
#   ★官方仓库里能直接下载的语言包不要写在这里★，只写进下面的 IMAGE_PACKAGES，
#     ImageBuilder 会自己去镜像源拉（例如 luci-i18n-upnp-zh-cn）。
SDK_EXTRA_APKS="
luci-app-msd_lite|luci-i18n-msd_lite-zh-cn
luci-app-vlmcsd|luci-i18n-vlmcsd-zh-cn
"

# --- 镜像里要装的全部包（官方仓库 + 自编 6 个 + 预编译 10 个 + 顺带产出 2 个语言包）----
# -dnsmasq dnsmasq-full ：OpenClash 需要 dnsmasq-full，替换掉默认的 dnsmasq
# odhcp6c/odhcpd-ipv6only：IPv6 客户端与 RA/DHCPv6 服务端（本就在默认包内，显式列出便于断言）
#
# ---- 2026-10 补装（全部来自官方仓库：直接写在本清单即可，不用 SDK 编、不必进 PREBUILT_APKS）----
# miniupnpd-nftables      ★必须显式点名★：luci-app-upnp 依赖的是一个"虚拟"的 miniupnpd
#                         提供者，由 miniupnpd-nftables 或 miniupnpd-iptables 任一满足。
#                         本机是 firewall4/nftables，若被解析到 iptables 版，就会"装上了但规则
#                         不生效"。verify.sh 会断言装的是 nftables 版、且没有 iptables 版。
# kmod-nft-tproxy         ★OpenClash 的 UDP 透明代理必需★：它不是 luci-app-openclash 声明的
#                         依赖（apk 依赖里没有它），而是 init 脚本运行时自己 `check_mod nft_tproxy`
#                         去 modprobe 的。缺了它 modprobe 失败 → nft 的 tproxy 规则整条装不上，
#                         `nft list ruleset` 里一条 tproxy 都没有，后果是 UDP/QUIC/DNS/游戏
#                         流量不走代理（只有 TCP 走）。本机实测过：装上并重启 OpenClash 后
#                         tproxy 规则从 0 条变成 2 条。kmod-nf-tproxy 会作为依赖自动带上。
# kmod-inet-diag          供 OpenClash「进程规则」用（默认 find_process_mode=off）。
#                         它不是必需，但 OpenClash 自带的内核模块自检会点名它，装上免得误报。
# luci-app-upnp           UPnP/NAT-PMP 的 LuCI 页面（服务 → UPnP/NAT-PMP）。
#                         ★镜像里默认不开★：自动开端口属于安全决策，首登后自己去页面上打开。
# luci-i18n-firewall-zh-cn
#                         LuCI 的每个 app 各有独立语言包，luci-i18n-base-zh-cn 不覆盖防火墙页。
#                         以后每加一个 luci-app-x，就配一个 luci-i18n-x-zh-cn：
#                           * x 来自官方仓库      → 只写在 IMAGE_PACKAGES 里（本行就是）
#                           * x 是 SDK 自编的      → 还要写进上面的 SDK_EXTRA_APKS
#                         ★容易漏★：自编 app 的语言包不会自动进镜像，漏了页面就是英文。
#                         本清单里 msd_lite / vlmcsd 两个 app 原来就是这么漏掉的。
#                         （lucky 的中文包自 r4 起与核心一起走 PREBUILT_APKS，
#                           不再由 SDK 编译产出，所以也不在 SDK_EXTRA_APKS 里。）
# pciutils / usbutils / nvme-cli
#                         lspci / lsusb / nvme —— x86 软路由排查 I226-V 网卡、USB、Optane 用。
# iperf3 / tcpdump / mtr-json
#                         打流测速与抓包：2.5G 口能不能跑满、丢包在哪一跳，靠它们才说得清。
#                         ★包名是 mtr-json（另有 mtr-nojson），但装好后命令就叫 mtr★ ——
#                         25.12 官方仓库里没有叫 mtr 的包，写 mtr 会直接构建失败。
IMAGE_PACKAGES="
luci luci-ssl luci-compat luci-app-package-manager
luci-i18n-base-zh-cn luci-i18n-package-manager-zh-cn luci-i18n-firewall-zh-cn luci-proto-ipv6
luci-theme-argon luci-app-argon-config luci-i18n-argon-config-zh-cn
luci-app-openclash
# kmod-veth：luci-app-ap-modem 的依赖（在该包 Makefile 的 LUCI_DEPENDS 里声明）。
# ★ 为什么这里还要再点一次名 ★ 作为依赖它会被 apk 装上，但**不会进 /etc/apk/world**
#   （world 只记显式请求的包），而离线校验只能读 world —— apk 的已安装库是 ADB
#   二进制格式，离线读不出包列表（见 verify.sh 里那段说明）。所以"只写依赖"时
#   verify.sh 的「清单里没有 kmod-veth」必然误报：2026-10-11 第一轮分支构建就是
#   153 项里唯一挂的一项，而同时 veth.ko 的文件断言是过的（说明依赖确实拉进来了）。
#   显式点名后既进 world、也在 manifest 里看得见。
kmod-nft-tproxy kmod-inet-diag kmod-veth
# lucky 三项来自 PREBUILT_APKS（作者的 OpenWrt 25.12 apk），不是 SDK 编的；
# luci-app-lucky 会自己把 rpcd-mod-file 依赖拉进来。
lucky luci-app-lucky luci-i18n-lucky-zh-cn
msd_lite luci-app-msd_lite luci-i18n-msd_lite-zh-cn
vlmcsd luci-app-vlmcsd luci-i18n-vlmcsd-zh-cn
luci-app-cnc-upgrade
# luci-app-ap-modem：SDK 自编（见上面 SDK_PACKAGES）。中文翻译由包内自带的
# 预编译 .lmo 提供，**不需要** luci-i18n-ap-modem-zh-cn，所以它不在
# SDK_EXTRA_APKS 里 —— 别看到别的 app 都配了语言包就顺手补一个，那个包不存在，
# ImageBuilder 会直接找不到包而构建失败。
# 它带 +kmod-veth 依赖（上游漏声明），ImageBuilder 从 kmods 源解析；kmod 那一行
# 里也显式点了名，原因见那行上面的说明。
luci-app-ap-modem
bandix luci-app-bandix luci-i18n-bandix-zh-cn
miniupnpd-nftables luci-app-upnp luci-i18n-upnp-zh-cn
kmod-wireguard wireguard-tools luci-proto-wireguard rpcd-mod-wireguard
-dnsmasq dnsmasq-full ip-full bash unzip ruby ruby-yaml ca-bundle jsonfilter
odhcp6c odhcpd-ipv6only
kmod-igc kmod-tun kmod-zram zram-swap
kmod-usb3 kmod-usb-storage kmod-fs-ext4 kmod-fs-vfat
irqbalance ethtool smartmontools lm-sensors openssh-sftp-server coreutils htop
pciutils usbutils nvme-cli iperf3 tcpdump mtr-json
"

# --- 构建期开关 ------------------------------------------------------------
# BAKE_SECRETS=1 时从 secrets/ 里读 PPPoE 账号密码与 root 密码哈希写进镜像。
# 默认 0：公开仓库/公开 Release 产物不会泄漏任何凭据，首次刷完在 LuCI 手填
# 一次宽带账号密码即可，之后靠 sysupgrade 保留 /etc/config 永久生效。
BAKE_SECRETS=0
# 是否跑 QEMU 冒烟（需要 qemu-system-x86 + ovmf，约 5–10 分钟）
RUN_QEMU_SMOKE=0
