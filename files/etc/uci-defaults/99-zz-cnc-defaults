#!/bin/sh
# CncTion 1338NP-12 首启收尾脚本（幂等，可重复执行）
#
# 命名用 99-zz- 前缀，确保在同目录其它 uci-defaults（如 Argon 的
# 30_luci-theme-argon）之后执行，最后拍板主题与网络相关默认值。

. /lib/functions.sh

# ------------------------------------------------------------------ 防火墙
# PPPoE 的 IPv6 动态接口名为 wan_6：由 ppp 包的 /lib/netifd/ppp6-up 通过
# `ubus call network add_dynamic` 创建（读源码确认 name="${PPP_IPPARAM}_6"）。
# 该脚本会尝试用 `fw3 -q network <父接口>` 继承父接口的 zone，但 fw3 由
# firewall3 包提供、firewall4(fw4) 并不提供，所以这里显式把 wan6 与 wan_6
# 都列入 wan zone。多列一个不存在的接口在 OpenWrt 里是被容忍的——官方默认
# 配置本身就列了 wan6。
#
# ★ 注意：官方默认 firewall 里的 wan zone 是**匿名段**（config zone + option
#   name 'wan'），所以不能用 `uci get firewall.wan` 去找——那样永远找不到，
#   2026-09 的 QEMU 冒烟就是这样抓到 wan_6 没被加进 zone 的。只能按 name 扫。
wanzone=""
zi=0
while [ "$zi" -lt 32 ]; do
	[ -n "$(uci -q get "firewall.@zone[$zi]")" ] || break
	if [ "$(uci -q get "firewall.@zone[$zi].name")" = "wan" ]; then
		wanzone="firewall.@zone[$zi]"
		break
	fi
	zi=$((zi + 1))
done
if [ -n "$wanzone" ]; then
	# ★ uci get 对 list 选项输出是"空格分隔的一行"，所以必须 grep -w；
	#   用 -x 会永远匹配不上，结果是每次都 add_list，把 wan6 加重复。
	for net in wan6 wan_6; do
		uci -q get "$wanzone.network" | grep -qw "$net" || uci add_list "$wanzone.network=$net"
	done
else
	logger -t cnc-defaults "找不到名为 wan 的 firewall zone，跳过 wan6/wan_6 登记"
fi

# ------------------------------------------------------------------ IPTV（eth1）
# eth1 是专用 IPTV 口（见 files/etc/config/network）。运营商 IPTV 是**组播**，
# 而配套的 m3u 播放列表里地址形如 http://192.168.2.1:4022/udp/239.253.232.77:8000
# —— 即由路由器上的 msd_lite 收下组播、再转成单播 HTTP 发给局域网客户端。
# 因此有两件事必须做对：
#
# ★1. 放行入站组播。组播流是**进到路由器本机**的（nft 的 input 方向），
#     不是转发。而 iptv zone 出于安全是 input REJECT，会把它整条挡掉 ——
#     症状是 msd_lite 返回 HTTP 503、一个字节都收不到，且 nft 里
#     reject_from_iptv 的计数一路增长（本机实测：加规则前是 503 / 0 字节，
#     加上之后同一路频道变成 200，约 8.9 Mbps）。
#     这里**不**把整个 zone 放开，只加 IGMP 与组播 UDP 两条精确规则。
# ★2. 这套配置原先只存在于旧系统手工配置的 /etc/config/firewall 里
#     （它是 conffile，升级时被带了过来），**镜像本身没有** ⇒ 干净刷机
#     （sysupgrade -n / 首次刷写）之后 IPTV 会失效。所以在这里补齐。
#
# 注意：组播规则放行的是 224.0.0.0/4（全部 IPv4 组播）。这样做是为了兼容
# 各省/各运营商不同的组播段；实际风险很低 —— 内核只会把组播交给**已加入**
# 该组的 socket，没加入的直接丢弃。想收得更紧就改成具体网段，例如本例
# m3u 里 112 个频道全在 239.253.232.0/24。

iptvzone=""
zi=0
while [ "$zi" -lt 32 ]; do
	[ -n "$(uci -q get "firewall.@zone[$zi]" 2>/dev/null)" ] || break
	if [ "$(uci -q get "firewall.@zone[$zi].name")" = "iptv" ]; then
		iptvzone="firewall.@zone[$zi]"
		break
	fi
	zi=$((zi + 1))
done
if [ -z "$iptvzone" ]; then
	uci add firewall zone >/dev/null
	iptvzone="firewall.@zone[-1]"
	uci set "$iptvzone".name='iptv'
	uci set "$iptvzone".input='REJECT'
	uci set "$iptvzone".output='ACCEPT'
	uci set "$iptvzone".forward='REJECT'
	logger -t cnc-defaults "已新建 iptv firewall zone（input REJECT，只放 IGMP 与组播）"
fi
# forward 保持 REJECT：组播由路由器本机的 msd_lite 转成单播，不需要 IPTV→LAN 转发。
# 不设 masq：IPTV 网段不做 NAT，避免它的地址/路由混进主网络。
uci -q get "$iptvzone.network" | grep -qw iptv || uci add_list "$iptvzone.network=iptv"

# 两条放行规则，按 name 查重（幂等：重复执行不会加出第二条）
add_iptv_rule() { # <name> <proto> [dest_ip]
	uci -q show firewall | grep -q "\.name='$1'" && return 0
	uci add firewall rule >/dev/null
	uci set firewall.@rule[-1].name="$1"
	uci set firewall.@rule[-1].src='iptv'
	uci set firewall.@rule[-1].proto="$2"
	[ -n "${3:-}" ] && uci set firewall.@rule[-1].dest_ip="$3"
	uci set firewall.@rule[-1].family='ipv4'
	uci set firewall.@rule[-1].target='ACCEPT'
	logger -t cnc-defaults "已新增 IPTV 防火墙规则 $1"
}
# IGMP 必须放行：路由器要往 IPTV 网络发成员报告；上游查询报文被挡掉的话，
# 交换机会在几分钟后把这个组剪掉，表现为"看一会儿就断"。
add_iptv_rule 'Allow-IGMP-IPTV' 'igmp'
add_iptv_rule 'Allow-IPTV-Multicast' 'udp' '224.0.0.0/4'

# msd_lite：把 IPTV 口的组播转成单播 HTTP。端口 4022 与 udpxy 默认端口一致，
# 常见公共 m3u 模板（形如 http://<路由器>:4022/udp/<组播组>:<端口>）直接可用。
# 它只监听局域网侧：iptv zone 是 input REJECT、wan zone 也是 REJECT，都到不了它。
if [ -f /etc/config/msd_lite ]; then
	uci -q get msd_lite.@instance[0] >/dev/null 2>&1 || uci add msd_lite instance >/dev/null
	uci set msd_lite.@instance[0].enabled='1'
	uci set msd_lite.@instance[0].address='0.0.0.0:4022'
	uci set msd_lite.@instance[0].network='iptv'
	uci commit msd_lite
	logger -t cnc-defaults "msd_lite 已配置：0.0.0.0:4022，组播收在 iptv 口"
fi

# ------------------------------------------------------------------ DNS 上游
# 给 dnsmasq 一组稳定的国内上游；wan 设了 peerdns=1，ISP 下发的 DNS 仍会一并使用。
if uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
	for dns in 223.5.5.5 119.29.29.29; do
		uci -q get dhcp.@dnsmasq[0].server | grep -qw "$dns" || uci add_list dhcp.@dnsmasq[0].server="$dns"
	done
fi

# ------------------------------------------------------------------ IPv6 服务端
# 对"静态地址的 lan"，odhcpd 自带的 odhcpd.defaults 本来就会打开 RA/DHCPv6；
# 这里显式复写一遍，避免将来上游默认值变化导致局域网 IPv6 悄悄失效。
if [ -e /proc/sys/net/ipv6 ]; then
	uci -q get dhcp.lan >/dev/null 2>&1 || {
		uci set dhcp.lan=dhcp
		uci set dhcp.lan.interface=lan
		uci set dhcp.lan.start=100
		uci set dhcp.lan.limit=150
		uci set dhcp.lan.leasetime=12h
	}
	uci set dhcp.lan.dhcpv6=server
	uci set dhcp.lan.ra=server
	uci set dhcp.lan.ra_slaac=1
	uci -q delete dhcp.lan.ra_flags
	uci add_list dhcp.lan.ra_flags=managed-config
	uci add_list dhcp.lan.ra_flags=other-config
fi

# ------------------------------------------------------------------ 默认主题
# 覆盖层里已写好，这里再拍板一次，防止上游 uci-defaults 抢改。
uci set luci.themes.Argon=/luci-static/argon
uci set luci.main.mediaurlbase=/luci-static/argon

# ------------------------------------------------------------------ root 密码
# 只有构建时 BAKE_SECRETS=1 才会带入 /etc/cnc-root-hash（SHA-512 crypt），
# 写入 /etc/shadow 后立即删除该文件，不留在系统里。
if [ -s /etc/cnc-root-hash ]; then
	hash="$(cat /etc/cnc-root-hash)"
	sed -i "s|^root:[^:]*:|root:${hash}:|" /etc/shadow
	rm -f /etc/cnc-root-hash
fi

uci -q commit firewall
uci -q commit dhcp
uci -q commit luci

exit 0
